# PHPStan at the highest level, as glitchr-studio/ci's workflow runs it. The baseline holds the 79
# findings of the code written before 1.1 (taken on 2026-11-10, before the identity-check and
# tenant-file contracts) and nothing else: anything new PHPStan reports fails. It shrinks, never grows.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
        - docker (?)
        - Tests/Fixtures (?)
