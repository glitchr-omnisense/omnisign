# PHPStan at the highest level, as glitchr-studio/ci's workflow runs it. The baseline is empty: the 79
# findings of the code written before 1.1 were fixed on 2026-11-10. Anything PHPStan reports fails.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
        - docker (?)
        - Tests/Fixtures (?)
    ignoreErrors:
        # The gateway packages are optional: the bundle lists those it knows and registers the ones
        # installed (class_exists). The package's CI analyses it with omnisign/docuseal only.
        -
            identifier: class.notFound
            path: Bridge/Symfony/OmnisignBundle.php
            reportUnmatched: false
