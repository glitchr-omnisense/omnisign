#!/usr/bin/env php
<?php

/**
 * Omnisign in bare PHP: no bundle, no container, no console component. The
 * registry is built by hand from the gateway packages installed, each says
 * what it offers and does, then a lease goes through each: created, sent,
 * fetched (completed), downloaded - the providers answering from their
 * packages' recorded answers. With --live, DocuSeal is asked for real
 * (DOCUSEAL_URL, DOCUSEAL_API_KEY, DOCUSEAL_TEMPLATE).
 *
 *   docker compose run --rm omnisign bare           # exits 1 when a class of a framework was loaded
 *   docker compose run --rm omnisign bare --json    # the same, whole: every class and file loaded
 *
 * OMNISIGN_AUTOLOAD names another autoloader than the harness's.
 */

use Omnisign\Model\Document;
use Omnisign\Model\Envelope;
use Omnisign\Model\Field;
use Omnisign\Model\File;
use Omnisign\Model\Signer;
use Omnisign\Registry;
use Omnisign\Request;

require getenv('OMNISIGN_AUTOLOAD') ?: '/harness/vendor/autoload.php';

$live = in_array('--live', $argv, true);
$recorded = new Symfony\Component\HttpClient\MockHttpClient(require __DIR__.'/../config/recorded.php');
$factories = [];
foreach (require __DIR__.'/../plugins.php' as [, $class]) {
    if (class_exists($class)) {
        $factories[] = new $class($live && str_ends_with($class, 'DocusealGatewayFactory') ? Symfony\Component\HttpClient\HttpClient::create() : $recorded);
    }
}
$installed = array_map(static fn ($factory) => $factory->getName(), $factories);
$config = [];
foreach (require __DIR__.'/../config/gateways.php' as $name => $gateway) {
    if (in_array($gateway['factory'], $installed, true)) {
        $options = $live && 'docuseal' === $name && getenv('DOCUSEAL_URL') ? $gateway['options'] : $gateway['example'];
        if ('@generate' === ($options['private_key'] ?? null)) {
            openssl_pkey_export(openssl_pkey_new(['private_key_bits' => 2048, 'private_key_type' => OPENSSL_KEYTYPE_RSA]), $pem);
            $options['private_key'] = $pem;
        }
        $config[$name] = ['factory' => $gateway['factory'], 'options' => $options];
    }
}
$registry = new Registry($factories, $config);

$operations = ['create' => Request\Create::class, 'send' => Request\Send::class, 'fetch' => Request\Fetch::class, 'remind' => Request\Remind::class, 'cancel' => Request\Cancel::class, 'download' => Request\Download::class, 'signing-url' => Request\SigningUrl::class, 'notify' => Request\Notify::class];
$report = ['live' => $live, 'gateways' => []];
foreach ($registry->all() as $name => $gateway) {
    $report['gateways'][$name] = ['title' => $gateway->getTitle(), 'does' => array_keys(array_filter($operations, static fn (string $r) => $gateway->supports($r)))] + $gateway->capabilities()->toArray();
}

$lease = new Envelope(
    'Bail - Maison Érable',
    [new Document('lease', new File("%PDF-1.4\n% a lease\n", 'bail.pdf'))],
    [new Signer('tenant', 'Camille Érable', 'camille@erable.example')],
    [new Field('tenant', 'lease', page: 1, x: 72, y: 600)],
    embedded: true,
    redirectUrl: 'https://meyers.example/leases/42/signed',
    key: 'lease-42',
);
foreach ($registry->all() as $name => $gateway) {
    $envelope = 'docuseal' === $name ? new Envelope($lease->title, signers: $lease->signers, embedded: true, template: getenv('DOCUSEAL_TEMPLATE') ?: '1', key: 'tenant') : $lease;
    $created = $gateway->create($envelope);
    $sent = $gateway->send($created);
    $fetched = $gateway->fetch($sent);
    $row = ['created' => [$created->reference, $created->status->value], 'sent' => $sent->status->value, 'fetched' => $fetched->status->value];
    if ('completed' === $fetched->status->value) {
        $download = $gateway->download($fetched);
        $row['download'] = [count($download->documents), substr($download->documents[0]->content ?? '', 0, 8), null !== $download->evidence];
    }
    $report['runs'][$name] = $row;
}

// What PHP loaded to get there: the proof that no framework was needed.
$report['symbols'] = [...get_declared_classes(), ...get_declared_interfaces(), ...get_declared_traits()];
$report['files'] = get_included_files();
$framework = array_values(preg_grep('~^(?:Symfony\\\\Component\\\\(?:DependencyInjection|Config|HttpKernel|HttpFoundation)|Symfony\\\\Bundle|Symfony\\\\Bridge|Doctrine|Twig)\\\\~', $report['symbols']));
$symfony = array_values(array_unique(array_map(static fn (string $s) => implode('\\', array_slice(explode('\\', $s), 0, 3)), preg_grep('~^Symfony\\\\(?!Polyfill)~', $report['symbols']))));
sort($symfony);

if (in_array('--json', $argv, true)) {
    echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
    exit($framework ? 1 : 0);
}

echo 'Omnisign in bare PHP: the registry built by hand, no bundle, no container; ', $live ? 'DocuSeal for real, the others recorded' : 'the providers\' recorded answers', ".\n\n";
foreach ($report['gateways'] as $name => $g) {
    printf("  %-9s %s: levels %s; in the page %s; third party %s; does %s\n", $name, $g['title'], implode(', ', $g['levels']), $g['embedded'] ? 'yes' : 'no', $g['thirdParty'] ? 'yes' : 'no', implode(' ', $g['does']));
}
echo "\n";
foreach ($report['runs'] ?? [] as $name => $r) {
    printf("  %-9s created %s (%s), sent: %s, fetched: %s%s\n", $name, $r['created'][0], $r['created'][1], $r['sent'], $r['fetched'], isset($r['download']) ? sprintf('; downloaded %d document(s) (%s), evidence %s', $r['download'][0], trim($r['download'][1]), $r['download'][2] ? 'yes' : 'no') : '');
}
echo "\nLoaded from Symfony: ", implode(', ', $symfony) ?: 'nothing', "\n";
echo 'Classes of a framework (DependencyInjection, Config, HttpKernel, HttpFoundation, a bundle or bridge, Doctrine, Twig): ', $framework ? implode(', ', $framework) : 'none', "\n";
exit($framework ? 1 : 0);
