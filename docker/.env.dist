# The gateways' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnisign gateways` says what is installed and configured.

# Where the gateways' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNISIGN_PLUGINS=../..
# omnisense/contracts from its checkout beside the family's folder (GitHub's 1.x otherwise):
#OMNISENSE_CONTRACTS=../../../omnisense-contracts

# omnisign/yousign: an API key (sandbox: api-sandbox.yousign.app).
YOUSIGN_API_KEY=
YOUSIGN_SANDBOX=1

# omnisign/docusign: an integration (its key, an RSA private key), the user it acts as, the account.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_ACCOUNT_ID=

# omnisign/docuseal: an instance's API root (https://sign.example.org/api) and its key;
# bare --live signs on it, with DOCUSEAL_TEMPLATE (a template with one signature field).
DOCUSEAL_URL=
DOCUSEAL_API_KEY=
DOCUSEAL_TEMPLATE=

# omnisign/stripe-identity: a secret key (sk_test_... for test mode: nothing is really checked),
# the webhook endpoint's secret (whsec_...).
STRIPE_IDENTITY_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=

# omnisign/dossierfacile: the partner's client on DossierFacile's Keycloak (partners under the
# charter only), the callback key DossierFacile sends in x-api-key; preprod by default here.
DOSSIERFACILE_CLIENT_ID=
DOSSIERFACILE_CLIENT_SECRET=
DOSSIERFACILE_CALLBACK_API_KEY=
DOSSIERFACILE_PREPROD=1
